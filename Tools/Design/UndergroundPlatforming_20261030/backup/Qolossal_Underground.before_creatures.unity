--- !u!114 &1427494759
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1427494757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: cradle-shelter-keeper
  displayName: Shelter keeper
  talks:
  - when: flag:mra:MR01_C01:reward
    once: 0
    lines:
    - That shell remembers the mountain's quieter days. Take its song to the listening
      tree in Qvale.
    - Past the mossy inlet, water runs away unless the spillway is closed.
  - when: 
    once: 1
    lines:
    - Come in. The stone keeps the wind off here.
    - The shell beside me is yours. Take it to the listening tree in Qvale when you
      find your way there.
    - Follow the trickle in Moss Pocket. Close the spillway, then let the water in.
  - when: 
    once: 0
    lines:
    - Rest as long as you like. Nothing here needs fighting.
  figure: {fileID: 880243176}
  labelHeight: 2.4

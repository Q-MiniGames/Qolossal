--- !u!114 &1190727552
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1190727550}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: marrow
  displayName: Marrow
  talks:
  - when: calm
    once: 1
    lines:
    - The terraces have never failed us. Warm soil all year round, even in a hard
      frost.
    - Folk say it's the springs. Folk say a lot of things.
  - when: calm
    once: 0
    lines:
    - Warm soil, good roots. Can't complain.
  - when: quake
    once: 1
    lines:
    - My rows have shifted a hand's width overnight. A hand's width!
    - Soil doesn't walk.
  - when: quake
    once: 0
    lines:
    - Soil doesn't walk. It doesn't.
  figure: {fileID: 334801835}
  labelHeight: 2.31

--- !u!114 &727717614
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 727717612}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: pip
  displayName: Pip
  talks:
  - when: calm
    once: 1
    lines:
    - Grandfather Tallow says the mountain dreams.
    - I drew it! There, on the wall. It's sleeping. See, that's its face.
    - He made me rub the face out. He said it's rude to draw someone who's asleep.
  - when: calm
    once: 0
    lines:
    - Want to see where I hide my Amber? ...No. It's a secret.
  - when: quake
    once: 1
    lines:
    - Did you feel the floor jump? Mum dropped the soup!
    - I think the mountain rolled over in its sleep.
  - when: quake
    once: 0
    lines:
    - I'm drawing the face again. Don't tell Grandfather.
  figure: {fileID: 930461735}
  labelHeight: 1.6500001

  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: fennel
  displayName: Fennel
  talks:
  - when: quake
    once: 1
    lines:
    - Did you hear it? Under the shaking, a low note.
    - Deeper than any string I own.
  - when: calm
    once: 1
    lines:
    - Sit a while. Music sounds better here; the ground hums along with it.
    - I only know one tune of my own. Find me song shells and I'll learn theirs.
  - when: 
    once: 0
    lines:
    - Sit on the bench. I'll play.
  figure: {fileID: 449292123}
  labelHeight: 2.09

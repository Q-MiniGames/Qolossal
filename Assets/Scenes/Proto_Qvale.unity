MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1481117102}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8433a4b85ae38534caf6b5f312588b18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownShop
  title: Brannick's smithy
  items:
  - name: Heart seed
    description: A seed from the old orchard. Plant it, and your heart grows. (+1
      heart)
    price: 60
    effect: 0
    flag: 
    once: 1
  - name: Oil for Wick's lamps
    description: Wick hasn't had oil for the street lamps since the frost. Pay for
      a season.
    price: 30
    effect: 1
    flag: lamps
    once: 1
  - name: A rumour
    description: Brannick heard something singing on the Brambles' roof.
    price: 15
    effect: 1
    flag: shell-hint
    once: 1
--- !u!114 &1481117105
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1481117102}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: brannick
  displayName: Brannick
  talks:
  - when: quake
    once: 1
    lines:
    - That shook a whole rack of tools off the wall, that did.
    - Well. What'll it be?
  - when: 
    once: 1
    lines:
    - Amber for goods, little sprout. That's how Qvale works.
    - Bring me what you find out there and I'll see what I can do.
  - when: 
    once: 0
    lines:
    - What'll it be?
  figure: {fileID: 330905907}
  labelHeight: 2.64

  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: herbalist
  displayName: Sorrel
  talks:
  - when: 
    once: 1
    lines:
    - Mind the drying racks. You look like you've climbed a long way.
    - Heart seeds take root in brave little chests. I'll sell you one, if you've
      the Amber.
  - when: quake
    once: 0
    lines:
    - The jars all hopped on the shelf. Nothing broken. This time.
  - when: 
    once: 0
    lines:
    - Something for the road?
  figure: {fileID: 223952721}
  labelHeight: 2.4

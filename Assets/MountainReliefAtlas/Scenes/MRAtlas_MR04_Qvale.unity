  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: wick
  displayName: Wick
  talks:
  - when: 
    once: 1
    lines:
    - Every lamp in Qvale, lit again. First time since I got lost.
    - You found me in the dark. I'll keep a light on for you.
  - when: 

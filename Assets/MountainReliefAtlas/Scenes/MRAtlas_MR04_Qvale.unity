MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2069808746}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: brannick
  displayName: Brannick
  talks:
  - when: 
    once: 1
    lines:
    - You got me out of that workshop, little one. The forge is lit again.
    - Bring Amber and I'll put a green sap edge on anything you carry.
  - when: quake
    once: 0
    lines:
    - Another tremor. Rattled every hook on the wall. What'll it be?
  - when: 
    once: 0
    lines:
    - What'll it be?
  figure: {fileID: 1464603359}
  labelHeight: 2.4

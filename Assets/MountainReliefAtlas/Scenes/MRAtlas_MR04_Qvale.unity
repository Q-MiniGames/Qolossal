  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: wick
  displayName: Wick
  talks:
  - when: 
    once: 1
    lines:
    - Every lamp in Qvale, lit again. First time since I got lost.
    - You found me in the dark. I'll keep a light on for you.
  - when: 
    once: 0
    lines:
    - The flames lean toward the high ground, then back. In, and out.
  figure: {fileID: 1323858243}
  labelHeight: 2.4

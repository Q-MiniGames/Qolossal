  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1044305771}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84d6c7466190f2b4d833a08cb92f66c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TownNpc
  id: pip
  displayName: Pip
  talks:
  - when: calm
    once: 1
    lines:
    - Did you come up from the hollows? Grandfather says nobody climbs up from there.
    - I want to see the lake at the top one day.
  - when: quake
    once: 1
    lines:
    - The floor jumped! My cup rolled right under the bed.
    - Grandfather says it's nothing. He said it twice.
  - when: 
    once: 0
    lines:
    - Want to see my drawing? It's a mountain. A sleepy one.
  figure: {fileID: 210166922}
  labelHeight: 2.4

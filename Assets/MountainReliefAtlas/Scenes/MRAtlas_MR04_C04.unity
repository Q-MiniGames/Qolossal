  displayName: Marrow
  talks:
  - when: 
    once: 1
    lines:
    - Home! You got me out of that shelter, and I won't forget it.
    - The terraces will need me back. Come by in the growing season.
  - when: 
    once: 0
    lines:
    - Warm soil, good roots. Can't complain.
  figure: {fileID: 223952721}
  labelHeight: 2.4
